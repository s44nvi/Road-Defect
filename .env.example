# Application Environment
ENVIRONMENT=development
APP_ENV=development

# Port Configuration
API_PORT=8000
WEB_PORT=3000

# Database Configuration (for Docker, use 'database' as hostname)
POSTGRES_DB=road_defect
POSTGRES_USER=road_defect
POSTGRES_PASSWORD=road_defect
# For local development: localhost | For Docker: database
DATABASE_URL=postgresql+psycopg://road_defect:road_defect@database:5432/road_defect

# Redis Configuration (for Docker, use 'redis' as hostname)
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO) Configuration (for Docker, use 'minio' as hostname)
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=road-evidence
MINIO_USER=road-defect
MINIO_PASSWORD=change-me-in-production
MINIO_ACCESS_KEY=road-defect
MINIO_SECRET_KEY=change-me-in-production
OBJECT_STORAGE_ACCESS_KEY=road-defect
OBJECT_STORAGE_SECRET_KEY=change-me

# Security Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Model Configuration
MODEL_PROVIDER=mock
MAP_PROVIDER=osm