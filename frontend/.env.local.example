# Client-side API boundary consumed by lib/api.ts. Leave unset to use the
# default "/api" same-origin path, which next.config.mjs proxies to
# BACKEND_ORIGIN below. Only set this to a full URL (e.g. a deployed
# backend) if you want the browser to call it directly.
# NEXT_PUBLIC_API_URL=/api

# Server-only proxy target for the /api rewrite in next.config.mjs.
# Never exposed to the client bundle. Point this at wherever the FastAPI
# backend is actually running (local uvicorn, tunnel, etc).
BACKEND_ORIGIN=http://localhost:8000

# Optional: only needed if you switch components/map away from the
# default token-free MapLibre + OSM raster setup to a Mapbox-hosted style.
# NEXT_PUBLIC_MAPBOX_TOKEN=

# Dev-only fallback for the citizen home map/report list: if set to "true"
# AND the real GET /defects call fails (e.g. no local backend running),
# the UI shows a small isolated sample dataset (lib/mock-defects.ts) with a
# visible "showing sample data" notice instead of an error state. Leave
# unset/false to always see the real error/empty states from the backend.
# NEXT_PUBLIC_ENABLE_DEFECT_MOCK=false
